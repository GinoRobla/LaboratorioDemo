PORT=4000

# Airtable Personal Access Token (crear en https://airtable.com/create/tokens
# con scopes data.records:read, data.records:write sobre la base del labo)
AIRTABLE_API_KEY=

# Se copia de la URL de la base: https://airtable.com/{BASE_ID}/...
AIRTABLE_BASE_ID=

# Nombres exactos de las tablas en Airtable
AIRTABLE_CATALOGO_TABLE=Catalogo
AIRTABLE_HISTORIAL_TABLE=Historial

# Origen permitido para CORS (URL del frontend)
FRONTEND_ORIGIN=http://localhost:5173
